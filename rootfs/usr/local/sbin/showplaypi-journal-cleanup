#!/bin/bash
# ShowPlayPI: removes system log entries older than 14 days (devices are often passed on without a reset, and
# the log contains e.g. visited addresses). Runs daily before showplaypi-data-hygiene.
#
# The log of every start that ended within the last 14 days is kept completely: right after a start without a
# clock the first entries are dated too early (the last known time or the build of the image – on a freshly
# flashed card weeks before), and they must not be removed as "old" once the clock is set. That is exactly the
# log of the first start, which tells how the card was set up.

RETENTION_SECONDS=$((14 * 24 * 3600))
now="$(date +%s)"

# The earliest entry of all starts that ended within the retention time (microseconds since 1970)
oldest_kept="$(journalctl --list-boots --output=json --no-pager 2>/dev/null | python3 -c '
import json, sys
limit = (int(sys.argv[1]) - int(sys.argv[2])) * 1000000
try:
    boots = json.load(sys.stdin)
except ValueError:
    boots = []
firsts = [b["first_entry"] for b in boots if b.get("last_entry", 0) >= limit and b.get("first_entry")]
print(min(firsts) // 1000000 if firsts else "")
' "$now" "$RETENTION_SECONDS" 2>/dev/null)"

keep_seconds="$RETENTION_SECONDS"
if [[ "$oldest_kept" =~ ^[0-9]+$ ]]; then
    needed=$(( now - oldest_kept + 60 ))
    [ "$needed" -gt "$keep_seconds" ] && keep_seconds="$needed"
fi

journalctl --vacuum-time="${keep_seconds}s" --quiet >/dev/null 2>&1
exit 0
